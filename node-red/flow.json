  {
    "id": "fn_scheduler",
    "type": "function",
    "z": "tab_main",
    "name": "sequential top-off scheduler",
    "func": "let st=flow.get('sched')||{phase:'idle',idx:0};const cfg=flow.get('cfg')||{};const d=msg.payload||{};if(d.nearCvl){st.phase='topoff';if(Array.isArray(d.tailOk)&&d.tailOk[st.idx]){st.idx=(st.idx+1)%((cfg.packs||[]).length||1);}}else{st.phase='idle';}flow.set('sched',st);msg.payload=st;return msg;",
    "outputs": 1
  },
  {
    "id": "fn_fsm_pack",
    "type": "function",
    "z": "tab_main",
    "name": "precharge FSM (per-pack)",
    "func": "const cfg=flow.get('cfg')||{prechargeMsMin:800,prechargeMsMax:3000,dvThresh:0.4};let s=context.get('s')||{state:'OPEN',t0:0};const now=Date.now();const dv=Math.abs((msg.vpack||0)-(msg.vbus||0));let coils={pre:false,main:false};let fault=null;function to(x){s.state=x;s.t0=now;}switch(s.state){case 'OPEN':if(msg.request==='precharge'){to('PRECHARGE');}break;case 'PRECHARGE':coils.pre=true;if((now-s.t0)>=cfg.prechargeMsMin && dv<=cfg.dvThresh){to('MAIN');}if((now-s.t0)>cfg.prechargeMsMax){fault='precharge_timeout';to('OPEN');}break;case 'MAIN':coils.main=true;if(msg.request==='open'){to('OPEN');}break;}context.set('s',s);msg.payload={i:msg.i,state:s.state,coils,fault};return msg;",
    "outputs": 1
  },
  {
    "id": "comment2",
    "type": "comment",
