    "func": "const cfg={mqttBase:\"N/\",vebusPath:\"vebus/276\",packs:[{name:\"pack1\",path:\"battery/pack1\"},{name:\"pack2\",path:\"battery/pack2\"},{name:\"pack3\",path:\"battery/pack3\"},{name:\"pack4\",path:\"battery/pack4\"},{name:\"pack5\",path:\"battery/pack5\"},{name:\"pack6\",path:\"battery/pack6\"}],cvlVolts:55.2,tailFrac:0.03,dvThresh:0.4,prechargeMsMin:800,prechargeMsMax:3000,modbus:{host:\"192.168.12.50\",port:502,unitId:1}};flow.set('cfg',cfg);msg.payload=cfg;return msg;",
